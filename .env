SECRET_KEY=29b9065ac46063da14fe51a361dc4fe7ecaf755ef3f2660c4831a034a0f1d3b3
SESSION_COOKIE_SECURE=false

# ============================================================
# Режим работы
# ============================================================
# true — только для локальной разработки
# false — обязательно для продакшн
FLASK_ENV=production
FLASK_DEBUG=false

# ============================================================
# Кеширование
# ============================================================
# SimpleCache — в памяти процесса (быстро, но не shared между воркерами)
# FileSystemCache — общий кеш через файлы
# RedisCache — рекомендую для прода (требует redis-py)
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300

